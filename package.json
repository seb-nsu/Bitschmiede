{
  "name": "game-studio-tycoon",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && node electron/start.mjs",
    "desktop:start": "node electron/start.mjs",
    "itch": "npm run build && node tools/itch.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/property",
    "determinism": "vitest run tests/determinism",
    "golden": "vitest run tests/golden",
    "golden:update": "tsx tools/golden.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run determinism && npm run golden",
    "tables": "tsx tools/tables.ts",
    "simulate": "tsx tools/simulate.ts",
    "bench": "tsx tools/bench.ts",
    "world": "tsx tools/world.ts",
    "mod:pack": "tsx tools/modpack.ts",
    "playsave": "tsx tools/playsave.ts",
    "ui:smoke": "node tools/ui-smoke.cjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "decimal.js": "^10.6.0",
    "electron": "^45.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.mjs",
  "description": "Wirtschaftssimulation über ein Spiele- und Engine-Studio, Prototyp Etappe 0"
}
